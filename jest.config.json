{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.test.json"
      }
    ]
  },
  "roots": ["<rootDir>/tests/unit"],
  "testMatch": ["**/*.test.ts"],
  "collectCoverageFrom": ["src/**/*.ts", "!src/index.ts", "!src/generated/**"],
  "coverageDirectory": "coverage",
  "coverageReporters": ["text", "lcov"]
}
