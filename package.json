{
  "name": "irrigation-db",
  "version": "1.0.0",
  "description": "PostgreSQL + Prisma backend for a sensor-driven irrigation system",
  "private": true,
  "license": "MIT",
  "author": "Kristian Lalev",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests prisma --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:studio": "prisma studio",
    "bench": "ts-node --transpile-only scripts/benchmark-index.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "prisma": "6.19.3",
    "winston": "3.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.1",
    "@types/supertest": "7.2.0",
    "@typescript-eslint/eslint-plugin": "8.60.0",
    "@typescript-eslint/parser": "8.60.0",
    "eslint": "9.39.4",
    "jest": "30.4.2",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "6.0.3"
  }
}
